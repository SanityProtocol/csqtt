# csqtt Android build image (CSQTT-APP-PLAN §3, M-158): the server image (Rust 1.97.1) plus a JDK, the Android SDK and NDK,
# the Android Rust targets and cargo-ndk. Pinned: the JDK and cmdline-tools by sha256, SDK packages by exact version (sdkmanager
# checks their own checksums), cargo-ndk by version (--locked). The SDK/NDK/cargo-ndk versions are those 2.5.3 was built with;
# Build-Tools 36 is AGP 9.2's default, which Gradle would otherwise fetch by itself mid-build.
ARG BASE=csqtt-ci-server
FROM ${BASE}
ARG JDK_URL=https://github.com/adoptium/temurin17-binaries/releases/download/jdk-17.0.21.1%2B2/OpenJDK17U-jdk_x64_linux_hotspot_17.0.21.1_2.tar.gz
ARG JDK_SHA256=0b0ac5eab6db6abaec68c9913bcddb31321e5da411c45073d520d9c125e6f7b4
ARG CLT_URL=https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip
ARG CLT_SHA256=2d2d50857e4eb553af5a6dc3ad507a17adf43d115264b1afc116f95c92e5e258
ARG CARGO_NDK=4.1.2
ENV JAVA_HOME=/opt/jdk ANDROID_HOME=/opt/android-sdk ANDROID_SDK_ROOT=/opt/android-sdk
RUN curl -fsSLo /tmp/jdk.tgz "$JDK_URL" && echo "$JDK_SHA256  /tmp/jdk.tgz" | sha256sum -c - \
 && mkdir -p $JAVA_HOME && tar -xzf /tmp/jdk.tgz -C $JAVA_HOME --strip-components=1 && rm /tmp/jdk.tgz
ENV PATH=/opt/jdk/bin:$PATH:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools
RUN curl -fsSLo /tmp/clt.zip "$CLT_URL" && echo "$CLT_SHA256  /tmp/clt.zip" | sha256sum -c - \
 && mkdir -p $ANDROID_HOME/cmdline-tools && unzip -q /tmp/clt.zip -d $ANDROID_HOME/cmdline-tools \
 && mv $ANDROID_HOME/cmdline-tools/cmdline-tools $ANDROID_HOME/cmdline-tools/latest && rm /tmp/clt.zip \
 && yes | sdkmanager --licenses >/dev/null \
 && sdkmanager "platform-tools" "platforms;android-37.0" "build-tools;37.0.0" "build-tools;36.0.0" "ndk;28.2.13676358" >/dev/null \
 && chmod -R a+rwX $ANDROID_HOME
ENV ANDROID_NDK_HOME=/opt/android-sdk/ndk/28.2.13676358
RUN rustup target add aarch64-linux-android armv7-linux-androideabi x86_64-linux-android --toolchain 1.97.1 \
 && cargo +1.97.1 install --locked cargo-ndk --version ${CARGO_NDK} && chmod -R a+rwX /usr/local/cargo
