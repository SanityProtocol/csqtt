# csqtt server-core build image (CSQTT-APP-PLAN §3, M-158, M-160). Every input is pinned: the base image by digest, Rust
# by version, Zig by sha256, cargo-zigbuild by version (--locked). These are the toolchain versions the shipped 2.5.3 cores
# were built with (Rust 1.97.1, Zig 0.15.2, cargo-zigbuild 0.23.4, the latest on 2026-10-16), so a rebuild of 2.5.3 in this
# image can be compared byte for byte. The base image's own Rust is never used: every build runs `cargo +1.97.1`.
FROM rust:1-bookworm@sha256:ade39a710ef85f3506cffcfec3e8a24ba090badef1dff2fb798f71d878833fea
ARG RUST=1.97.1
ARG ZIG=0.15.2
ARG ZIG_SHA256=02aa270f183da276e5b5920b1dac44a63f1a49e55050ebde3aecc9eb82f93239
ARG CARGO_ZIGBUILD=0.23.4
RUN rustup toolchain install ${RUST} --profile minimal \
 && rustup target add x86_64-unknown-linux-musl aarch64-unknown-linux-musl armv7-unknown-linux-musleabihf --toolchain ${RUST}
RUN for i in 1 2 3 4 5; do curl -fsSLo /tmp/zig.tar.xz https://ziglang.org/download/${ZIG}/zig-x86_64-linux-${ZIG}.tar.xz && break; sleep 10; done \
 && echo "${ZIG_SHA256}  /tmp/zig.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/zig.tar.xz -C /opt && rm /tmp/zig.tar.xz && ln -s /opt/zig-x86_64-linux-${ZIG}/zig /usr/local/bin/zig
RUN cargo +${RUST} install --locked cargo-zigbuild --version ${CARGO_ZIGBUILD} && chmod -R a+rwX /usr/local/cargo
